# AIAniDrama Configuration

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./projects/.anidrama.db

# SRD Provider Configuration
# 文本模型和视频模型使用以下配置
SRD_API_KEY=your-srd-api-key
SRD_API_BASE_URL=https://your-srd-api-base-url.com/llm/v1
# 图片生成模型使用独立的配置，需要在环境变量中设置 SRD_IMAGE_API_KEY 和 SRD_IMAGE_API_BASE_URL

# Ark Provider Configuration
ARK_API_KEY=your-ark-api-key

# Dashscope Provider Configuration
DASHSCOPE_API_KEY=your-dashscope-api-key

# OpenAI Provider Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Grok Provider Configuration
GROK_API_KEY=your-grok-api-key

# Kling Provider Configuration
KLING_API_KEY=your-kling-api-key

# Project Settings
PROJECTS_DIR=./projects
STATIC_DIR=./static