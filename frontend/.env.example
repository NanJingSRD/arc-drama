# 复制为 .env.development 后按需修改（本地 dev 用 base=/）
VITE_APP_BASE=/

# 本地 dev 时 Vite 代理 /api 的目标后端
# - 连测试机：http://your-test-server:1240
# - 连本机后端：http://127.0.0.1:1240
VITE_API_PROXY_TARGET=http://127.0.0.1:1240

# 工作空间 2.0 项目/模型设置接口（/api/ws2/* → 1242）
VITE_WORKSPACE_V2_API_PROXY_TARGET=http://127.0.0.1:1242

# 首页轮播等资源接口（/api/resource/*）
VITE_RESOURCE_API_PROXY_TARGET=http://127.0.0.1:8003

# 微信登录 API（/aigc/nexus/api/*，独立第三方服务，与站点 /nexus/ 算力平台无关）
VITE_NEXUS_API_PROXY_TARGET=http://127.0.0.1:8005

# 轮播/作品视频 MinIO（/aigc/media/* → 本地 dev 由 Vite 代理）
VITE_MEDIA_PROXY_TARGET=http://127.0.0.1:9000

# 工作空间登录方式：不设或 true = 微信；false = 手动 token（测试机仍须登录）
# VITE_WORKSPACE_REQUIRES_WECHAT_AUTH=false

# ── 构建命令 ──
# pnpm run build       → .env.test  → 测试机
# pnpm run build:prod  → .env.prod  → 生产环境