# 测试机构建（pnpm run build → 部署到 /aigc/）
# 须与 nginx location /aigc/ 及 vite base 一致，否则 index.html 会引用 /assets/... 导致白屏
VITE_APP_BASE=/aigc/

# 测试环境不要求微信登录，但仍须 token 登录后才能进工作空间
VITE_WORKSPACE_REQUIRES_WECHAT_AUTH=false

# 本地 dev 代理用；测试机 API 由 nginx /aigc/api/ → 127.0.0.1:1240 转发
VITE_API_PROXY_TARGET=http://your-test-server:1240